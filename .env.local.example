# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Resend ────────────────────────────────────────────────────────────────────
# Get this from: https://resend.com → API Keys
RESEND_API_KEY=re_your_api_key_here

# ── Email Addresses ───────────────────────────────────────────────────────────
# The "from" address must be on a verified domain in Resend
RESEND_FROM_EMAIL=noreply@yourdomain.com
ADMIN_EMAIL=your-admin@email.com

# ── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://chalkboardtuitions.in
NEXT_PUBLIC_WHATSAPP_NUMBER=917411446381

# ── WhatsApp Cloud API (Meta) — Phase 2 attendance notifications ──────────────
# Optional: until these are set, messages queue safely and never send.
# Get from: Meta Business Manager → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-permanent-access-token
# Webhook verify token (for future delivery/read receipts)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=any-random-string
